GOOGLE_API_KEY=
SERPAPI_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
# Backend defaults; developer testing can override these without a user-facing selector.
TRVELLE_WEB_SEARCH_PROVIDER=brave
TRVELLE_PLACE_SEARCH_PROVIDER=brave
BRAVE_MONTHLY_REQUEST_LIMIT=100
BRAVE_RUN_REQUEST_LIMIT=20
BRAVE_REQUESTS_PER_SECOND=1
BRAVE_ITINERARY_PLACE_LIMIT=8
OPENROUTER_API_KEY=
# Model order is configured in trvelle/config/model_tiers.yaml
# MODEL_TIERS_CONFIG=trvelle/config/model_tiers.yaml
# MODEL_COOLDOWN_DB=.runtime/model-routing.sqlite3
# Self-hosted VM: show SSH tunnel setup before ChatGPT loopback sign-in.
# TRVELLE_MODEL_SSH_HOST=ubuntu@YOUR_VM_HOST
DB_URI=postgresql://USER:YOUR_DATABASE_PASSWORD@127.0.0.1:54329/trvelle
# Optional local PostgreSQL container in compose.yaml. Use the same password in DB_URI.
POSTGRES_PASSWORD=
BACKEND_API_TOKEN=generate-a-shared-random-secret
# For historical travel-tool replay (model inference is separate):
# TRVELLE_SEARCH_MODE=replay
# TRVELLE_REPLAY_DIR=tests/fixtures/search
# TRVELLE_RECORD_SEARCH_DIR=.runtime/search-recordings

# Optional server-side affiliate booking links. Never expose the token in NEXT_PUBLIC_* variables.
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_PROJECT_ID=
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_REQUESTS_PER_MINUTE=80
# Optional comma-separated direct brand domains to attempt converting.
# TRAVELPAYOUTS_ALLOWED_HOSTS=booking.com,agoda.com,trip.com
